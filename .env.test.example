# Live-database integration tests ONLY. Must point at the disposable STAGING
# Supabase project — never production (.env). The loader refuses to run if this
# URL equals the one in .env. Copy to .env.test (gitignored) and fill in.
VITE_SUPABASE_URL=https://your-staging-ref.supabase.co
VITE_SUPABASE_ANON_KEY=staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key
