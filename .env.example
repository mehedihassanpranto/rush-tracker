# ── Public (safe for browser, bundled by Vite) ────────────────────────────────
# Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── SERVER ONLY — never add a VITE_ prefix to these ──────────────────────────
# Service-role key bypasses RLS. Must only ever exist on the server (Vercel
# env var without VITE_ prefix / local .env). Never import into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta Marketing API — System User access token from your Business Portfolio
# (Business Settings → System Users → Generate New Token, scopes: ads_read,
# business_management). Optional: the app runs fine without it, the
# "Fetch from Meta" / "Import from Meta" features just stay unavailable.
META_SYSTEM_USER_TOKEN=your-meta-system-user-token
META_BUSINESS_ID=your-business-portfolio-id
META_API_VERSION=v21.0

# Shared secret for POST /api/cron/meta-sync — generate with e.g.
# `openssl rand -hex 32`. Optional: unset disables the sync endpoint (503).
CRON_SECRET=your-random-cron-secret
